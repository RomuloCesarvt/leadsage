{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test:templates": "npx esbuild src/templates/sites/layouts.test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/layouts.test.mjs && node node_modules/.cache/layouts.test.mjs",
    "test:docs": "npx esbuild src/templates/docs/docs.test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/docs.test.mjs && node node_modules/.cache/docs.test.mjs",
    "test:front": "npm run test:templates && npm run test:docs && npm run test:geo",
    "geo": "node scripts/gerar-geo.mjs",
    "test:geo": "npx tsx src/lib/geo.test.ts"
  },
  "dependencies": {
    "axios": "^1.19.0",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "firebase": "^12.17.1",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "country-state-city": "^3.2.1"
  }
}
