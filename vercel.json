{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": {
        "maxDuration": 60,
        "memory": 1024
      }
    },
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.py"
    },
    {
      "src": "/s/(.*)",
      "dest": "/api/index.py"
    },
    {
      "src": "/privacidade/?",
      "dest": "/privacidade.html"
    },
    {
      "src": "/(lp|inicio)/?",
      "dest": "/lp.html"
    },
    {
      "src": "/termos/?",
      "dest": "/termos.html"
    },
    {
      "src": "/exclusao-de-dados/?",
      "dest": "/exclusao-de-dados.html"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
