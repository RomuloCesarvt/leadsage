# Copie este arquivo para ".env" (sem o nome exemplo) e preencha.

# A chave que o LeadSage mostra ao clicar em "Gerar chave" (Robo > WhatsApp pelo computador).
LEADSAGE_KEY=

# Endereco do LeadSage (deixe como esta, salvo se tiver outro dominio).
LEADSAGE_URL=https://leadsageofc.vercel.app

# O OpenWA que roda no seu computador.
OPENWA_URL=http://localhost:2785
# Chave de API do OpenWA: docker exec openwa-api cat /app/data/.api-key
OPENWA_KEY=

# Nome da sessao de WhatsApp dentro do OpenWA (pode deixar).
OPENWA_SESSION=leadsage
